{
  "name": "dpdp-kit",
  "version": "0.4.1",
  "description": "Build India's DPDP Act 2023 into your Node.js backend: declared purposes, tamper-evident consent records, erasure plans and an audit you can run in CI.",
  "keywords": [
    "dpdp",
    "dpdpa",
    "dpdp-act",
    "india",
    "privacy",
    "consent",
    "data-protection",
    "erasure",
    "compliance",
    "drizzle",
    "prisma",
    "mongodb",
    "mongoose",
    "postgres"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogesh2902/dpdp-kit.git"
  },
  "homepage": "https://dpdp-kit.js.org/",
  "bugs": {
    "url": "https://github.com/yogesh2902/dpdp-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.15.0",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "bin": {
    "dpdp-kit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "default": "./dist/nestjs.js"
    },
    "./schedule": {
      "types": "./dist/schedule.d.ts",
      "default": "./dist/schedule.js"
    },
    "./protect": {
      "types": "./dist/protect.d.ts",
      "default": "./dist/protect.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    },
    "./mongodb": {
      "types": "./dist/mongodb.d.ts",
      "default": "./dist/mongodb.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "site": "node site/build.mjs"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.38"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "hono": "^4.13.19",
    "marked": "^18.2.1",
    "mongodb": "~7.8.0",
    "mongodb-memory-server": "11.3.0",
    "mongoose": "9.12.2",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shiki": "^4.6.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
